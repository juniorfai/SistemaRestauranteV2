# Copia este fichero como .env (no se sube a git) y rellena los valores.

# Dominio del servidor. Con un dominio real, Caddy obtiene el certificado HTTPS automáticamente
# (el DNS debe apuntar ya a este servidor y los puertos 80 y 443 deben estar abiertos).
# Para probar en tu ordenador deja ":80" y entra en http://localhost
SITE_ADDRESS=:80

# Contraseña de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
DB_PASSWORD=
DB_NAME=RestauranteMaster

# Clave para firmar las sesiones: larga y aleatoria (mínimo 32 caracteres). Si cambia, todos
# tienen que volver a iniciar sesión. Puedes generarla con:  openssl rand -base64 48
JWT_KEY=

# Administrador de la plataforma (quien da de alta los restaurantes). Se crea en el primer
# arranque; después cambia la contraseña desde «Mi cuenta» y puedes vaciar estas dos líneas.
PLATFORM_ADMIN_USER=plataforma
PLATFORM_ADMIN_NAME=Administración
PLATFORM_ADMIN_PASSWORD=

# Zona horaria del servidor (las reservas se guardan en hora local del restaurante).
TZ=Europe/Madrid

# Solo para una demo: carga un restaurante de ejemplo con usuarios de prueba. Nunca en producción real.
SEED_DEMO_DATA=false

# Puertos publicados (cámbialos solo si 80/443 están ocupados, por ejemplo al probar en local).
HTTP_PORT=80
HTTPS_PORT=443
