@baseUrl = https://localhost:7191/api

### 1) Iniciar sesión (ejecutar primero; las demás peticiones usan su token)
# @name login
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

@token = {{login.response.body.$.token}}

### Usuario de la sesión
GET {{baseUrl}}/Auth/me
Authorization: Bearer {{token}}

### Mesas libres para 4 personas
GET {{baseUrl}}/Table/available?dateTime=2030-01-15T20:00&numberOfPeople=4
Authorization: Bearer {{token}}
Accept: application/json

### Reservas próximas
GET {{baseUrl}}/Reservation
Authorization: Bearer {{token}}
Accept: application/json

### Crear reserva
POST {{baseUrl}}/Reservation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reservationDateTime": "2030-01-15T20:00",
  "numberOfPeople": 4,
  "customerId": 1,
  "tableId": 6,
  "specialRequests": "Cumpleaños",
  "menuItemIds": [3],
  "quantities": [2]
}

### Confirmar reserva
PATCH {{baseUrl}}/Reservation/1/confirm
Authorization: Bearer {{token}}

### Datos de mi restaurante
GET {{baseUrl}}/Restaurant/current
Authorization: Bearer {{token}}

### ---------- Administración de la plataforma ----------

### Iniciar sesión como plataforma
# @name platformLogin
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
  "username": "plataforma",
  "password": "Plataforma123!"
}

@platformToken = {{platformLogin.response.body.$.token}}

### Todos los restaurantes
GET {{baseUrl}}/Restaurant
Authorization: Bearer {{platformToken}}

### Alta de restaurante con su primer administrador
POST {{baseUrl}}/Restaurant
Authorization: Bearer {{platformToken}}
Content-Type: application/json

{
  "name": "Casa Ejemplo",
  "address": "Calle Mayor 1",
  "phoneNumber": "600123456",
  "email": "hola@casaejemplo.test",
  "openingHours": "L-D 13:00-23:30",
  "adminUsername": "casaejemplo",
  "adminFullName": "Responsable Casa Ejemplo",
  "adminPassword": "CambiaEsto123!"
}

### Suspender un restaurante (isActive: true para reactivarlo)
PATCH {{baseUrl}}/Restaurant/2/active
Authorization: Bearer {{platformToken}}
Content-Type: application/json

{
  "isActive": false
}
